FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    # Python
    python3-minimal \
    # Build tools
    make \
    git \
    latexmk \
    # Core LaTeX - copre: inputenc, fontenc, geometry, graphicx, setspace,
    #              tabularx, array, longtable, fancyhdr, titlesec, float,
    #              colortbl, enumitem, amssymb, amsmath, makeidx
    texlive-latex-extra \
    # Copre: xcolor, tcolorbox, tikz, todonotes
    texlive-pictures \
    # Copre: xurl, hyperref
    texlive-latex-recommended \
    # Copre: eurosym
    texlive-fonts-extra \
    # Copre: babel italian
    texlive-lang-italian \
    # Font T1 encoding
    texlive-fonts-recommended \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

WORKDIR /workspace